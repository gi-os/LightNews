<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only ever used to scan the OAuth client id QR; nothing here takes a photo. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Brightness, for the hardware wheel. This is an appop rather than a runtime
      permission, and LightOS has no Settings screen to send the user to, so it is granted
      once over adb:

        adb shell appops set com.gios.lightnews WRITE_SETTINGS allow

      Without the grant the wheel falls back to a window-level brightness override, which
      needs no permission but only dims this app.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Android 11+ hides other packages unless declared. Launching an implicit intent
      never consults this, but resolveActivity() does, and that is what decides whether
      the app can tell the user in advance that nothing here opens a web page.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <!--
      Plenty of newsletters still serve their artwork over http. The app's own traffic
      is https by construction (the Gmail and OAuth endpoints are hardcoded), so this
      only affects subresources inside the reader's WebView.
    -->
    <application
        android:name=".LightNewsApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Newsletters"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightNews">

        <!--
          singleTask so the OAuth redirect comes back into the running activity through
          onNewIntent, rather than stacking a second copy on top of the reader.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Newsletters"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LightNews">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The OAuth redirect: com.gios.lightnews:/oauth2redirect. Scheme only, no
              host or path — Android will not match a path element unless a host is also
              declared, and a redirect with a host is not what Google issues here.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.gios.lightnews" />
            </intent-filter>
        </activity>
    </application>
</manifest>
